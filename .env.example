# =====================================================================
# CardTax — environment variables
# Copy to .env (gitignored) and fill in the values you need.
# Anything you skip falls back to a sane dev default or disables that feature.
# =====================================================================

# --- App ---------------------------------------------------------------
# Optional. Public URL of the deployed app. Used in robots.txt + sitemap and
# in absolute links in emails. If unset, the app guesses from request headers.
CARDTAX_PUBLIC_URL=https://cardtax.app

# Same idea, used by the billing/checkout flow for redirect URLs.
APP_BASE_URL=https://cardtax.app

# Cookie signing key. *Must* be set in production — otherwise sessions are
# invalidated on every restart (the app falls back to a random per-boot key).
CARDTAX_SESSION_SECRET=change-me-to-a-long-random-string

# Token required to view the admin pages (/admin, /admin/messages and the
# waitlist endpoints). Leave blank locally to skip the check.
CARDTAX_ADMIN_TOKEN=

# --- Google OAuth (optional — disables "Sign in with Google" if unset) -
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe (optional — disables paid plans + webhooks if unset) -------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs, one per paid tier. Create them in the Stripe dashboard.
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_UNLIMITED=price_...

# --- SendGrid (optional — emails go to the server console if unset) ----
SENDGRID_API_KEY=
CARDTAX_EMAIL_FROM=noreply@cardtax.app
CARDTAX_EMAIL_FROM_NAME=CardTax

# --- eBay OAuth (optional — disables the eBay sync flow if unset) ------
# Create credentials at https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Production redirect URL "RuName" registered with eBay.
EBAY_RU_NAME=
# Use "sandbox" while developing against the eBay sandbox, "production" otherwise.
EBAY_ENV=production

# --- AI card scanner (optional — disables /scan if unset) --------------
# Uses OpenAI's vision API to identify cards from a photo.
OPENAI_API_KEY=
# Override the default vision model if you want.
CARD_SCANNER_MODEL=gpt-4o-mini

# --- Analytics (optional) ----------------------------------------------
# Google Analytics 4 measurement ID. Loaded only on public pages.
GOOGLE_ANALYTICS_ID=

# --- Error tracking (optional) ----------------------------------------
# Sentry DSN. When set, unhandled exceptions are reported to Sentry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Session store (optional) -----------------------------------------
# When set, sessions are stored server-side in Redis instead of signed
# cookies. Falls back to cookies when unset or when Redis is unreachable.
REDIS_URL=
